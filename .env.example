# Zambian Scam Detector Configuration (Template)
# Copy this file to .env and replace the values

# API Key for dashboard and backend access
SCAM_API_KEY=your-secure-api-key-here

# Database path
# SCAM_DB_PATH=detections.db

# API Configuration
SCAM_API_LOG_TO_DB=True
SCAM_API_LIMIT_DAY=200 per day
SCAM_API_LIMIT_HOUR=50 per hour
SCAM_API_BATCH_MAX_ITEMS=100
